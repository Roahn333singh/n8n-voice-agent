        "name": "Note: outbound"
      },
      {
        "parameters": {
          "content": "## Inbound: call results from Dograh\nDograh POSTs here when the call ends (Authorization: Bearer secret).\nSave the feedback -> queue row **Completed** -> fill ended_at / duration / outcome in Call_Attempts.",
          "height": 220,
          "width": 1000,
          "color": 4
        },
        "type": "n8n-nodes-base.stickyNote",
