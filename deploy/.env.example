# Copy to .env on the server:  cp .env.example .env  &&  chmod 600 .env
# Never commit .env or send it over chat. Keep a copy in a password manager.

# Public hostname whose DNS A record points at the server's static IP.
DOMAIN=n8n.example.com

# Email for Let's Encrypt certificate notices (optional but recommended).
ACME_EMAIL=you@example.com

# Pin the n8n version. Upgrade on purpose, after testing.
N8N_VERSION=2.41.6

# Generate each with:  openssl rand -hex 32
# N8N_ENCRYPTION_KEY encrypts every saved credential. If you lose it, all credentials are unreadable.
# Use a NEW one for every client. Keep the SAME one when moving an existing instance.
N8N_ENCRYPTION_KEY=
DB_PASSWORD=

TIMEZONE=Asia/Kolkata

# How long to keep execution history (hours). 336 = 14 days.
EXECUTIONS_MAX_AGE_HOURS=336
