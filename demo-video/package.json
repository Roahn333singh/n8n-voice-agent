{
  "name": "aurelia-explainer-video",
  "version": "1.0.0",
  "private": true,
  "description": "Premium motion explainer with replacement real-call audio",
  "scripts": {
    "studio": "remotion studio",
    "still": "remotion still Explainer out/still.png",
    "render": "bash ./scripts/render.sh",
